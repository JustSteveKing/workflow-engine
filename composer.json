{
    "name": "juststeveking/workflow-engine",
    "description": "Durable, resumable workflows for the long-running Laravel processes that spend most of their time waiting.",
    "keywords": [
        "laravel",
        "workflow",
        "workflow-engine",
        "state-machine",
        "saga",
        "orchestration",
        "process-manager",
        "long-running",
        "signals"
    ],
    "license": "MIT",
    "homepage": "https://github.com/juststeveking/workflow-engine",
    "support": {
        "issues": "https://github.com/juststeveking/workflow-engine/issues",
        "source": "https://github.com/juststeveking/workflow-engine",
        "docs": "https://github.com/juststeveking/workflow-engine/blob/main/docs/README.md"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/juststeveking"
        }
    ],
    "authors": [
        {
            "role": "Developer",
            "name": "Steve McDougall",
            "email": "steve@juststeveking.com",
            "homepage": "https://juststeveking.link"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "JustSteveKing\\WorkflowEngine\\": "src/",
            "JustSteveKing\\WorkflowEngine\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JustSteveKing\\WorkflowEngine\\Tests\\": "tests/"
        },
        "classmap": [
            "examples/"
        ]
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "pint",
        "stan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JustSteveKing\\WorkflowEngine\\WorkflowEngineServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
